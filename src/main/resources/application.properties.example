# Copiá este archivo a application.properties (mismo directorio) y completá lo tuyo.
# application.properties está en .gitignore: nunca subas credenciales al repo.
#
# Variables de entorno que espera:
#   MAIL_USERNAME / MAIL_PASSWORD  cuenta de Gmail que manda los codigos
#   REMEMBER_ME_KEY                cualquier texto largo y fijo. Recomendado en
#                                  produccion. Si no se define, la clave se genera
#                                  una vez y se guarda en ./uploads/remember-me.key
#                                  (o en app.security.remember-me-archivo, si se
#                                  fija otra ruta) para sobrevivir a los reinicios;
#                                  solo se pierde si ese archivo se borra o el disco
#                                  no admite escritura.
#   COOKIES_SEGURAS                true en produccion (con HTTPS), false en local
#   JWT_SECRET                     clave para firmar los tokens de la API movil
#                                  (32+ caracteres). Si no se define, se genera una
#                                  al azar en cada arranque y los tokens ya emitidos
#                                  se invalidan al reiniciar el server.

# --- Base de datos (XAMPP/MySQL) ---
# Para una instalación nueva, creá la base con db/schema.sql
spring.datasource.url=jdbc:mysql://localhost:3306/escuela-empresa
spring.datasource.username=root
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# validate: Hibernate no crea ni toca tablas, solo verifica que coincidan con las entidades
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false

# Las columnas se llaman como en las entidades (fechaNac, no fecha_nac)
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

server.port=8080

# --- Sesion y cookies ---
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=lax
# En produccion, detras de HTTPS, esto TIENE que ser true (COOKIES_SEGURAS=true en
# el entorno): si no, la cookie de sesion viaja legible y en la red de la escuela
# cualquiera en el mismo tramo se la lleva. En desarrollo queda en false porque
# sobre http el navegador no manda una cookie marcada como secure y no se podria
# ni entrar.
server.servlet.session.cookie.secure=${COOKIES_SEGURAS:false}

# --- Actuator ---
# Viene con el starter en el pom. Sin esto quedaba expuesto lo que trae por
# defecto a cualquier usuario logueado; con esto, solo el estado y sin detalles.
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never

# --- Correo (código de primer ingreso y recuperación de contraseña) ---
# Con Gmail hace falta una "contraseña de aplicación", no la de la cuenta.
# Se leen de las variables de entorno MAIL_USERNAME / MAIL_PASSWORD; también podés
# escribirlas acá directamente.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# --- Archivos que suben los alumnos ---
# Relativo al directorio desde donde se lanza la app (o absoluto en el servidor)
app.uploads.directorio=./uploads/planillas
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

app.url.base=http://localhost:8080

# --- API movil (/api/movil/**), usada por la app Android ---
# app.jwt.secret=${JWT_SECRET:}
app.jwt.expiration-ms=86400000

# --- Producción ---
# Clave de las cookies "recordarme". Si no se fija, ahora se genera una sola vez
# y se guarda en ./uploads/remember-me.key para sobrevivir a los reinicios; fijarla
# acá igual sigue siendo lo recomendado (evita depender de que ese archivo no se
# pierda o de que el disco admita escritura ahí).
# REMEMBER_ME_KEY=una-cadena-larga-y-secreta

# Redirige todo http a https y hace que las cookies de sesion y "recordarme" viajen
# marcadas como secure. Apagado por defecto porque en localhost (sin https) dejaria
# a cualquiera afuera. Prendelo en produccion.
# app.security.forzar-https=true

# Si el servidor esta detras de un proxy/balanceador que termina el https (Nginx,
# Render, etc.), esto le dice a Spring que confie en los headers X-Forwarded-* para
# saber que el pedido original fue https, aunque a la app le llegue por http.
server.forward-headers-strategy=framework
