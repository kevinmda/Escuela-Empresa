# PLANTILLA de configuracion. Copiar a src/main/resources/application.properties
# y completar los valores de la instalacion.
#
# El application.properties real esta en el .gitignore a proposito, porque lleva
# los datos de conexion a la base. Este archivo existe para que quien clone el
# repositorio sepa que claves hacen falta: sin el, la aplicacion no arranca y no
# hay forma de saber por que.
#
# Variables de entorno que espera:
#   MAIL_USERNAME / MAIL_PASSWORD  cuenta de Gmail que manda los codigos
#   REMEMBER_ME_KEY                cualquier texto largo y fijo. Si no se define,
#                                  se genera uno al azar en cada arranque y todos
#                                  los "Recordarme" se caen con cada reinicio.
#   COOKIES_SEGURAS                true en produccion (con HTTPS), false en local

# --- Base de datos (XAMPP/MySQL) ---
spring.datasource.url=jdbc:mysql://localhost:3306/escuela-empresa
spring.datasource.username=CAMBIAR
spring.datasource.password=CAMBIAR
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=validate
# En false: con true se escribia cada consulta al log, incluidas las de las
# pantallas con datos de alumnos. Para depurar, ponerlo en true un rato.
spring.jpa.show-sql=false

# Evita que Hibernate convierta los nombres de columna a snake_case
# automáticamente (ej: fechaNac -> fecha_nac). Sin esto, @Column(name="fechaNac")
# no funciona como se espera y tira error de "missing column".
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

server.port=8080

# --- Sesion y cookies ---
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=lax
# En produccion, detras de HTTPS, esto TIENE que ser true (COOKIES_SEGURAS=true en
# el entorno): si no, la cookie de sesion viaja legible y en la red de la escuela
# cualquiera en el mismo tramo se la lleva. En desarrollo queda en false porque
# sobre http el navegador no manda una cookie marcada como secure y no se podria
# ni entrar.
server.servlet.session.cookie.secure=${COOKIES_SEGURAS:false}
# Para que la aplicacion sepa que la peticion original venia por https cuando hay
# un proxy adelante (nginx, Apache) y arme bien los redirects.
server.forward-headers-strategy=framework

# --- Actuator ---
# Viene con el starter en el pom. Sin esto quedaba expuesto lo que trae por
# defecto a cualquier usuario logueado; con esto, solo el estado y sin detalles.
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never

# --- Correo (activación de cuenta / recuperación de contraseña) ---
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.uploads.directorio=./uploads/planillas
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
app.url.base=http://localhost:8080