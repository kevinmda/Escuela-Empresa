# Copiá a .env (mismo directorio que docker-compose.yml) y completá.
# .env está en .gitignore: nunca subas este archivo con valores reales.

MYSQL_ROOT_PASSWORD=elegi-una-clave-larga
MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=contraseña-de-aplicacion-de-gmail
REMEMBER_ME_KEY=cadena-larga-y-secreta
JWT_SECRET=otra-cadena-larga-de-32-caracteres-o-mas

# Dominio publico (ej. midominio.duckdns.org). Caddy le saca el certificado HTTPS.
DOMINIO=midominio.duckdns.org
APP_URL_BASE=https://midominio.duckdns.org

# Con Caddy delante la app siempre va por HTTPS: dejar en true.
# (Para probar en local sin Caddy/dominio, ponerlos en false y APP_URL_BASE=http://localhost:8080)
COOKIES_SEGURAS=true
APP_SECURITY_FORZAR_HTTPS=true
