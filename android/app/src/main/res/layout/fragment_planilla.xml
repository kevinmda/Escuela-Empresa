<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refrescarPlanillas"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_md"
                android:paddingBottom="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo_planilla"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/texto_principal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="@dimen/espacio_md"
                    android:text="@string/subtitulo_planilla"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/texto_secundario" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tarjetaResumenPlanillas"
                    style="@style/Widget.GestorPasantes.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/espacio_sm"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="@string/resumen_semanas_cargadas"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="@color/texto_principal" />

                            <TextView
                                android:id="@+id/textoResumenHoras"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/on_exito_contenedor"
                                tools:text="240.00 hs" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progresoResumenPlanillas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_sm"
                            android:max="6"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp"
                            app:indicatorColor="@color/acento"
                            tools:progress="4" />

                        <TextView
                            android:id="@+id/textoResumenSemanas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/texto_secundario"
                            tools:text="4 de 6 semanas cargadas" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <include
                android:id="@+id/shimmerPlanillas"
                layout="@layout/layout_shimmer_lista"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <include
                android:id="@+id/estadoErrorPlanillas"
                layout="@layout/layout_estado_error"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/textoPlanillasVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.6"
                    android:contentDescription="@null"
                    app:tint="@color/texto_secundario"
                    app:srcCompat="@drawable/ic_vacio" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_sm"
                    android:gravity="center"
                    android:textColor="@color/texto_secundario"
                    android:text="@string/planillas_vacio" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaPlanillas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="@dimen/espacio_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCargarMasPlanillas"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boton_cargar_mas"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonDescargarInforme"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boton_descargar_informe" />
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/botonNuevaPlanilla"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/espacio_md"
        android:contentDescription="@string/boton_nueva_planilla"
        app:backgroundTint="@color/acento"
        app:tint="@color/on_acento"
        app:srcCompat="@drawable/ic_agregar" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
