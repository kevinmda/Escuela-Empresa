<?xml version="1.0" encoding="utf-8"?>
<!-- Mismo texto y tratamiento sutil que .credito-disenio en la web: chico,
     en el color secundario, sin ningún énfasis. Se usa via <include> en vez
     de repetir el TextView en cada pantalla. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espacio_lg"
    android:text="@string/credito_autoria"
    android:textAppearance="?attr/textAppearanceBodySmall"
    android:textColor="?attr/colorOnSurfaceVariant" />
