<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refrescarDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Estado de error: solo si falla el primer intento de cargar el perfil -->
            <include
                android:id="@+id/estadoErrorDashboard"
                layout="@layout/layout_estado_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contenidoDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_md">

                <TextView
                    style="@style/Titulo.GestorPasantes.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:layout_marginBottom="@dimen/espacio_md"
                    android:text="@string/tab_inicio"
                    android:textColor="@color/texto_principal" />

                <!-- Mismo aviso que la campana del header web (ver
                     ChromeContext.Aviso), pero como una fila por aviso sin
                     leer en vez de un desplegable — acá no hay una barra
                     superior compartida entre pantallas donde meter una
                     campana. Vacío y oculto hasta que cargarAvisos() agregue
                     alguna fila; no participa del shimmer/error de las otras
                     3 tarjetas porque no es un dato crítico para la pantalla. -->
                <LinearLayout
                    android:id="@+id/contenedorAvisos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Tarjeta "dossier": mismo concepto que la credencial/carnet de
                     alumno/index.html en la web, adaptado a mobile. La franja
                     dorada a la izquierda es la marca de identidad, no decoración
                     suelta: el mismo dorado que usa la web para acentos. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.GestorPasantes.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/espacio_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="match_parent"
                            android:background="@color/acento" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/espacio_md">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dashboard_dossier"
                                    android:textAllCaps="true"
                                    android:letterSpacing="0.03"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="@color/texto_secundario" />

                                <TextView
                                    style="@style/Texto.GestorPasantes.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_chip_exito"
                                    android:textColor="@color/on_exito_contenedor"
                                    android:text="@string/dashboard_pasante_activo" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textoSaludo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/espacio_xs"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="@color/texto_principal"
                                tools:text="Belén Zárate" />

                            <TextView
                                android:id="@+id/textoEspecialidadCurso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/texto_secundario"
                                tools:text="Informática · 3° Curso, Sección B" />

                            <View
                                style="@style/Divisor.GestorPasantes"
                                android:layout_marginVertical="@dimen/espacio_sm" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_cedula"
                                        android:textAllCaps="true"
                                        android:letterSpacing="0.03"
                                        android:textAppearance="?attr/textAppearanceLabelSmall"
                                        android:textColor="@color/texto_secundario" />

                                    <TextView
                                        android:id="@+id/textoCedula"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceTitleSmall"
                                        android:textColor="@color/texto_principal"
                                        tools:text="5.482.109" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_expediente"
                                        android:textAllCaps="true"
                                        android:letterSpacing="0.03"
                                        android:textAppearance="?attr/textAppearanceLabelSmall"
                                        android:textColor="@color/texto_secundario" />

                                    <TextView
                                        android:id="@+id/textoExpediente"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceTitleSmall"
                                        android:textColor="@color/on_acento_contenedor"
                                        tools:text="#CTN-12" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Skeleton de carga: 4 bloques imitando la grilla de tarjetas de abajo -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_margin="@dimen/espacio_xs"
                            android:layout_marginBottom="@dimen/espacio_sm"
                            android:background="@drawable/bg_shimmer_bloque" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="110dp"
                                android:layout_weight="1"
                                android:layout_margin="@dimen/espacio_xs"
                                android:background="@drawable/bg_shimmer_bloque" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="110dp"
                                android:layout_weight="1"
                                android:layout_margin="@dimen/espacio_xs"
                                android:background="@drawable/bg_shimmer_bloque" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="110dp"
                                android:layout_weight="1"
                                android:layout_margin="@dimen/espacio_xs"
                                android:background="@drawable/bg_shimmer_bloque" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="110dp"
                                android:layout_weight="1"
                                android:layout_margin="@dimen/espacio_xs"
                                android:background="@drawable/bg_shimmer_bloque" />
                        </LinearLayout>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <!-- Grilla real de tarjetas, oculta hasta que llegan los 3 pedidos -->
                <LinearLayout
                    android:id="@+id/grillaDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/tarjetaSemanas"
                            layout="@layout/item_tarjeta_dashboard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="@dimen/espacio_xs" />

                        <include
                            android:id="@+id/tarjetaHoras"
                            layout="@layout/item_tarjeta_dashboard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="@dimen/espacio_xs" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/tarjetaDocumentos"
                            layout="@layout/item_tarjeta_dashboard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="@dimen/espacio_xs" />

                        <include
                            android:id="@+id/tarjetaEmpresa"
                            layout="@layout/item_tarjeta_dashboard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="@dimen/espacio_xs" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
