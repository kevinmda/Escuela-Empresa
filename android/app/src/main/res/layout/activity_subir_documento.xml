<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/barraSubir"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="@string/titulo_subir_documento" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_tipo_documento"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/texto_secundario"
            android:letterSpacing="0.04" />

        <Spinner
            android:id="@+id/spinnerTipoDocumento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:layout_marginBottom="@dimen/espacio_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonElegirArchivo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boton_elegir_archivo" />

        <TextView
            android:id="@+id/textoArchivoElegido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_sm"
            android:textColor="@color/texto_secundario"
            android:text="@string/ningun_archivo_elegido" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonSubirDocumento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_lg"
            android:text="@string/boton_subir" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progresoSubida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/espacio_md"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
