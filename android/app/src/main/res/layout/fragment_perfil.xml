<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refrescarPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/tamano_avatar"
                    android:layout_height="@dimen/tamano_avatar"
                    android:background="@drawable/bg_icono_circular"
                    android:backgroundTint="@color/primario_contenedor"
                    android:padding="14dp"
                    android:contentDescription="@null"
                    app:tint="@color/on_primario_contenedor"
                    app:srcCompat="@drawable/ic_perfil" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_md"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/texto_principal"
                        tools:text="Nombre Apellido" />

                    <TextView
                        android:id="@+id/textoCursoSeccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/texto_secundario"
                        tools:text="6to Informática A" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_lg"
                app:cardBackgroundColor="@color/superficie"
                app:cardCornerRadius="@dimen/radio_tarjeta"
                app:cardElevation="0dp"
                app:strokeColor="@color/contorno"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/espacio_md">

                    <include layout="@layout/item_dato_perfil" android:id="@+id/filaEspecialidad" />
                    <View style="@style/Divisor.GestorPasantes" />
                    <include layout="@layout/item_dato_perfil" android:id="@+id/filaEmpresa" />
                    <View style="@style/Divisor.GestorPasantes" />
                    <include layout="@layout/item_dato_perfil" android:id="@+id/filaSupervisor" />
                    <View style="@style/Divisor.GestorPasantes" />
                    <include layout="@layout/item_dato_perfil" android:id="@+id/filaTelefono" />
                    <View style="@style/Divisor.GestorPasantes" />
                    <include layout="@layout/item_dato_perfil" android:id="@+id/filaEmail" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCambiarContrasena"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_lg"
                android:text="@string/boton_cambiar_contrasena" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCerrarSesion"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_sm"
                android:text="@string/boton_cerrar_sesion"
                android:textColor="@color/error"
                app:strokeColor="@color/error"
                app:rippleColor="@color/error" />

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
