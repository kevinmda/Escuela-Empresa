<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/superficie"
    app:cardCornerRadius="@dimen/radio_tarjeta"
    app:cardElevation="0dp"
    app:strokeColor="@color/contorno"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_md">

        <ImageView
            android:id="@+id/iconoTarjeta"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icono_circular"
            android:backgroundTint="@color/primario_contenedor"
            android:padding="7dp"
            android:contentDescription="@null"
            app:tint="@color/on_primario_contenedor"
            tools:src="@drawable/ic_planilla" />

        <TextView
            android:id="@+id/valorTarjeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_sm"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/texto_principal"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="4 de 6" />

        <TextView
            android:id="@+id/etiquetaTarjeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/texto_secundario"
            android:maxLines="2"
            tools:text="Semanas cargadas" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
