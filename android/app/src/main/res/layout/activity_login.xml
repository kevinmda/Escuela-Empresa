<?xml version="1.0" encoding="utf-8"?>
<!-- Sin tarjeta envolviendo el formulario: la web NO tiene panel ni divisor acá
     (ver el comentario sobre .auth-split en styles.css, "UNA sola superficie,
     no hay panel ni divisor") — todo flota directo sobre el fondo con
     degradado, igual que ahí. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_login"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal|center_vertical"
        android:padding="@dimen/espacio_lg">

        <!-- Logo real del colegio, como en la web (fragments/auth ::
             logoTarjeta), no un ícono genérico. -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/nombre_colegio"
            android:src="@drawable/logo_ctn" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_md"
            android:gravity="center"
            android:text="@string/titulo_ingresar"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/login_texto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:layout_marginBottom="@dimen/espacio_lg"
            android:gravity="center"
            android:text="@string/subtitulo_ingresar"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/login_texto_secundario" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoEmail"
            style="@style/Widget.GestorPasantes.TextInputLayout"
            app:boxBackgroundColor="@color/login_campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoPassword"
            style="@style/Widget.GestorPasantes.TextInputLayout"
            app:boxBackgroundColor="@color/login_campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_sm"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/login_texto_secundario"
            android:hint="@string/hint_password">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_md"
            android:text="@string/boton_ingresar" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progresoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/espacio_md"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Color de texto a mano: en la web ".auth-links a" usa —ink-soft (un
             gris, no el dorado de acento) y solo se pone dorado en hover — sin
             hover en mobile, se deja directo en el tono sutil. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonOlvideContrasena"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/espacio_sm"
            android:textColor="@color/login_texto_secundario"
            android:text="@string/boton_olvide_contrasena" />

        <include layout="@layout/credito_autoria" />

    </LinearLayout>
</ScrollView>
