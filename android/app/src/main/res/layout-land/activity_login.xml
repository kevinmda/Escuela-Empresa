<?xml version="1.0" encoding="utf-8"?>
<!-- En horizontal, un formulario a lo ancho se ve estirado feo: se lo limita a una
     columna centrada de ancho fijo, en vez de repetir la version portrait tal cual.
     Sin tarjeta, mismo motivo que la version portrait: la web no tiene panel acá. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_login"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/espacio_lg">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/nombre_colegio"
                android:src="@drawable/logo_ctn" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_sm"
                android:gravity="center"
                android:text="@string/titulo_ingresar"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/login_texto" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:layout_marginBottom="@dimen/espacio_md"
                android:gravity="center"
                android:text="@string/subtitulo_ingresar"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/login_texto_secundario" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoEmail"
                style="@style/Widget.GestorPasantes.TextInputLayout"
                app:boxBackgroundColor="@color/login_campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoPassword"
                style="@style/Widget.GestorPasantes.TextInputLayout"
                app:boxBackgroundColor="@color/login_campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_sm"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/login_texto_secundario"
                android:hint="@string/hint_password">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonIngresar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_md"
                android:text="@string/boton_ingresar" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progresoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espacio_md"
                android:indeterminate="true"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonOlvideContrasena"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espacio_sm"
                android:textColor="@color/login_texto_secundario"
                android:text="@string/boton_olvide_contrasena" />

            <include layout="@layout/credito_autoria" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
