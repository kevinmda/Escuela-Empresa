<?xml version="1.0" encoding="utf-8"?>
<!-- En horizontal los seis dias se acomodan en dos columnas de tres, en vez de una
     sola lista larga como en portrait (misma idea que fragment_perfil en horizontal). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/barraPlanilla"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="@string/titulo_planilla" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonVerPdf"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_md"
                android:text="@string/boton_ver_pdf"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/contenedorDiasIzquierda"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/espacio_sm" />

                <LinearLayout
                    android:id="@+id/contenedorDiasDerecha"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/espacio_sm" />
            </LinearLayout>

            <View style="@style/Divisor.GestorPasantes" android:layout_marginVertical="@dimen/espacio_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoSupervisor"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_sm"
                    android:hint="@string/hint_supervisor">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputSupervisor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="100" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoConocimientos"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_sm"
                    android:hint="@string/hint_conocimientos">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputConocimientos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="265"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/espacio_sm">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoExperiencia"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_sm"
                    android:hint="@string/hint_experiencia">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputExperiencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="200"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoAprendizaje"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_sm"
                    android:hint="@string/hint_aprendizaje">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputAprendizaje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="200"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textoErrorPlanilla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_sm"
                android:textColor="@color/error"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGuardarPlanilla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_md"
                android:text="@string/boton_guardar_planilla" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progresoPlanilla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espacio_md"
                android:indeterminate="true"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
