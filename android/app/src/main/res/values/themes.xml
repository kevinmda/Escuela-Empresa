<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GestorPasantes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/primario_contenedor</item>
        <item name="colorOnPrimaryContainer">@color/on_primario_contenedor</item>
        <item name="colorSecondary">@color/acento</item>
        <item name="colorOnSecondary">@color/on_acento</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="colorSurfaceVariant">@color/superficie_variante</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/contorno</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>

        <!-- Sin esto, Android dibuja una "starting window" con el tema por defecto
             mientras arranca la siguiente Activity, lo que se ve como un parpadeo a
             modo claro antes de que se pinte el layout real en modo oscuro. -->
        <item name="android:windowDisablePreview">true</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.GestorPasantes.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.GestorPasantes.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.GestorPasantes.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.GestorPasantes.Medium</item>

        <item name="materialButtonStyle">@style/Widget.GestorPasantes.Button</item>
        <item name="toolbarStyle">@style/Widget.GestorPasantes.Toolbar</item>
        <item name="textInputStyle">@style/Widget.GestorPasantes.TextInputLayout</item>
    </style>

    <!-- —radius-field de la web son 12px en las CUATRO esquinas — el FilledBox
         de Material redondea solo las de arriba por default (imita el guión
         inferior clásico de M2). Con esquinas parejas queda igual que el campo
         hundido de la web. -->
    <style name="ShapeAppearanceOverlay.GestorPasantes.Campo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.GestorPasantes.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.GestorPasantes.Campo</item>
        <item name="boxBackgroundColor">@color/campo</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="ShapeAppearance.GestorPasantes.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.GestorPasantes.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.GestorPasantes.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <!-- colorSecondary (el dorado de acento) en vez del colorPrimary por
             default de Material: en modo oscuro colorPrimary es un celeste
             pálido pensado como color de texto, no como relleno de botón (ver
             el comentario en values-night/colors.xml). El dorado es el color
             de acción de la marca en los dos temas, y ya es el que usa el
             botón del login. -->
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="rippleColor">?attr/colorOnSecondary</item>
        <!-- —radius-btn de la web es 999px (pastilla completa): 50% del alto
             del propio botón da lo mismo sin importar el minHeight que tenga
             cada uno. -->
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.GestorPasantes.Pastilla</item>
    </style>

    <style name="ShapeAppearanceOverlay.GestorPasantes.Pastilla" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Login: la web fuerza modo oscuro en estas pantallas (auth-split—login
         en styles.css), sin toggle ni depender del tema guardado del usuario
         — mismo criterio acá, con los colores login_* fijos (ver colors.xml)
         en vez de los de arriba, que sí cambian con values-night/. -->
    <style name="Theme.GestorPasantes.Login" parent="Theme.GestorPasantes">
        <item name="colorPrimary">@color/login_acento</item>
        <item name="colorOnPrimary">@color/login_bg</item>
        <item name="colorSurface">@color/login_superficie</item>
        <item name="colorOnSurface">@color/login_texto</item>
        <item name="colorOnSurfaceVariant">@color/login_texto_secundario</item>
        <item name="colorOutline">@color/login_contorno</item>
        <item name="colorError">@color/login_error</item>
        <item name="android:colorBackground">@color/login_bg</item>
        <item name="android:windowBackground">@color/login_bg</item>
        <item name="android:statusBarColor">@color/login_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/login_texto</item>
        <item name="android:textColorSecondary">@color/login_texto_secundario</item>
        <item name="toolbarStyle">@style/Widget.GestorPasantes.Toolbar.Login</item>
    </style>

    <!-- Sin esto, el toolbar de recuperar/restablecer contraseña heredaría
         colorPrimary (dorado, ver Theme.GestorPasantes.Login de arriba) como
         fondo — una barra dorada no es el tratamiento de estas pantallas en
         la web, ahí es una superficie oscura más, sin barra destacada. -->
    <style name="Widget.GestorPasantes.Toolbar.Login" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/login_bg</item>
        <item name="titleTextColor">@color/login_texto</item>
        <item name="navigationIconTint">@color/login_texto</item>
    </style>

    <style name="Widget.GestorPasantes.Toolbar" parent="Widget.Material3.Toolbar">
        <!-- Color propio (barra_superior) en vez de colorPrimary: en modo
             oscuro colorPrimary es un celeste pálido pensado como color de
             texto, no como relleno solido de una barra (ver el comentario en
             values-night/colors.xml). Blanco fijo para el texto/ícono porque
             la barra es oscura (navy) en los dos temas, no solo en oscuro. -->
        <item name="android:background">@color/barra_superior</item>
        <item name="titleTextColor">@color/blanco</item>
        <item name="navigationIconTint">@color/blanco</item>
    </style>

    <style name="Divisor.GestorPasantes" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/contorno</item>
    </style>

    <!-- Tarjeta "elevated" de M3: sombra suave en vez de borde, para que la UI
         no se vea plana. Antes todas las tarjetas eran outlined (0dp de
         elevacion + borde fino), correcto pero chato. -->
    <style name="Widget.GestorPasantes.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">@dimen/radio_tarjeta</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Chip de texto tipo "credencial" (Portal 2025, Escuela Empresa, estados).
         No es un componente interactivo, por eso un TextView simple y no
         com.google.android.material.chip.Chip: mas liviano para algo que solo
         se lee. -->
    <style name="Texto.GestorPasantes.Chip" parent="">
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Títulos de sección (Inicio, Documentos, el nombre en Perfil): misma
         idea que "main h2" en la web — barra de acento a la izquierda y
         sangría para separar el texto de la barra. sans-serif-medium en vez
         de Space Grotesk (la fuente real de la web): sin poder verificar con
         certeza los certificados exactos que hacen falta para una fuente
         descargable de Google, se prefiere no arriesgar una fuente que
         termine fallando en silencio — esta es la más parecida de las que
         ya trae Android sin depender de nada externo. -->
    <style name="Titulo.GestorPasantes.Seccion" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/barra_titulo_seccion</item>
    </style>
</resources>
