<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GestorPasantes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/primario_contenedor</item>
        <item name="colorOnPrimaryContainer">@color/on_primario_contenedor</item>
        <item name="colorSecondary">@color/acento</item>
        <item name="colorOnSecondary">@color/on_acento</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="colorSurfaceVariant">@color/superficie_variante</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/contorno</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>

        <!-- Sin esto, Android dibuja una "starting window" con el tema por defecto
             mientras arranca la siguiente Activity, lo que se ve como un parpadeo a
             modo claro antes de que se pinte el layout real en modo oscuro. -->
        <item name="android:windowDisablePreview">true</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.GestorPasantes.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.GestorPasantes.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.GestorPasantes.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.GestorPasantes.Medium</item>

        <item name="materialButtonStyle">@style/Widget.GestorPasantes.Button</item>
        <item name="toolbarStyle">@style/Widget.GestorPasantes.Toolbar</item>
    </style>

    <style name="ShapeAppearance.GestorPasantes.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.GestorPasantes.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.GestorPasantes.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.GestorPasantes.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
    </style>

    <style name="Divisor.GestorPasantes">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/contorno</item>
    </style>
</resources>
