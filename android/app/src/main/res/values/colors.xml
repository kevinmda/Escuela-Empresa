<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Misma paleta que la web (static/css/styles.css): navy y dorado salen
         del logo del colegio, no son colores M3 genéricos. -->
    <color name="primario">#16233D</color>
    <color name="primario_oscuro">#0E1626</color>
    <color name="primario_contenedor">#DCE1EA</color>
    <color name="on_primario_contenedor">#16233D</color>

    <color name="acento">#D99A1F</color>
    <color name="on_acento">#2A1B03</color>
    <color name="acento_contenedor">#FBEECD</color>
    <color name="on_acento_contenedor">#8A5D0A</color>

    <color name="secundario_contenedor">#DCE8F5</color>
    <color name="on_secundario_contenedor">#1B4E82</color>

    <color name="terciario_contenedor">#E8DDFF</color>
    <color name="on_terciario_contenedor">#2C1B4D</color>

    <color name="exito">#2F7A4D</color>
    <color name="on_exito">#FFFFFF</color>
    <color name="exito_contenedor">#E3F2E8</color>
    <color name="on_exito_contenedor">#1E5236</color>

    <color name="error">#C1272D</color>
    <color name="on_error">#FFFFFF</color>

    <color name="fondo">#F4F2EC</color>
    <color name="superficie">#FFFFFF</color>
    <color name="superficie_variante">#E7ECF2</color>
    <!-- --line de la web es #DCD6C8 (un gris cálido, de la misma familia que --bg),
         no el gris azulado que había acá. -->
    <color name="contorno">#DCD6C8</color>
    <!-- --ink de la web hace doble función: acción primaria Y texto principal.
         Achica la separación que tenía la app entre "primario" (color de acción)
         y "texto_principal" (un gris carbón sin relación con la paleta). -->
    <color name="texto_principal">#16233D</color>
    <!-- --ink-soft exacto de la web (antes difería en el último dígito). -->
    <color name="texto_secundario">#55637A</color>
    <color name="blanco">#FFFFFF</color>

    <!-- Login: la web fuerza modo oscuro en estas pantallas sin importar el
         tema guardado del usuario (auth-split--login en styles.css, no tienen
         toggle). Colores fijos acá, iguales a los de esa clase, en vez de los
         de arriba (que sí cambian con values-night/) -- si no, el login se
         vería distinto según el tema del sistema, cosa que la web no hace. -->
    <color name="login_bg">#14171C</color>
    <color name="login_superficie">#1D222A</color>
    <color name="login_texto">#EAEEF5</color>
    <color name="login_texto_secundario">#A4B0C2</color>
    <color name="login_acento">#E5B04D</color>
    <color name="login_contorno">#333D4C</color>
    <color name="login_error">#F08A7D</color>
    <!-- --field de la web: color-mix(in srgb, var(--bg) 55%, var(--surface))
         con los valores oscuros de arriba. -->
    <color name="login_campo">#181C22</color>
</resources>
