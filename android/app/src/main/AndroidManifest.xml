<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para escanear documentos con la cámara desde Subir documento. No
         "required": el resto de la app funciona igual en un dispositivo sin
         cámara, esa pantalla simplemente no ofrece la opción de escanear. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.GestorPasantes"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".SubirDocumentoActivity"
            android:exported="false"
            android:label="@string/titulo_subir_documento" />

        <activity
            android:name=".CambiarContrasenaActivity"
            android:exported="false"
            android:label="@string/titulo_cambiar_contrasena" />

        <activity
            android:name=".RecuperarContrasenaActivity"
            android:exported="false"
            android:label="@string/titulo_recuperar_contrasena" />

        <activity
            android:name=".RestablecerContrasenaActivity"
            android:exported="false"
            android:label="@string/titulo_restablecer_contrasena" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
