# Copiá este archivo a keystore.properties (mismo directorio) y completá lo tuyo.
# keystore.properties está en .gitignore: nunca subas contraseñas ni el .jks al repo.
#
# El .jks real (keystore/gestor-pasantes-release.jks) también está en .gitignore.
# Guardalo en un lugar seguro fuera del repo (password manager, disco cifrado): si
# se pierde, no se puede volver a firmar esta misma app para actualizarla -- hay
# que repartir una app "distinta" a quien ya tenga la vieja instalada.

storeFile=keystore/gestor-pasantes-release.jks
storePassword=
keyAlias=gestor-pasantes
keyPassword=
